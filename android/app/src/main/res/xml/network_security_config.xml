<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext is permitted because users can open arbitrary http:// streams
      (IPTV, LAN media servers). Only system CAs are trusted in release builds
      so a user-installed certificate cannot be used to intercept traffic.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug builds additionally trust user CAs for proxy-based debugging. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
